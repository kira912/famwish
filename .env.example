# =============================================================================
# FamWish - Variables d'Environnement
# =============================================================================

# PostgreSQL (Géré automatiquement par Vercel Postgres / Neon / Supabase)
# Lorsque vous ajoutez Vercel Postgres à votre projet Vercel, POSTGRES_URL est injecté automatiquement !
POSTGRES_URL="postgres://default:password@ep-sample-pooler.eu-central-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# Ou DATABASE_URL standard
# DATABASE_URL="postgres://postgres:password@localhost:5432/famwish"

# Google Auth Client ID (Optionnel pour le One-Tap Google)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=""
